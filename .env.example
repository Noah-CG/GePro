# URL de connexion Neon (Dashboard Neon > Connect > "Pooled connection").
# Laisser vide pour utiliser la base locale de démo (dossier .pglite/).
DATABASE_URL=

# Fuseau horaire de l'équipe (sert à calculer "aujourd'hui", "en retard", "cette semaine").
APP_TIMEZONE=Europe/Paris

# --- Intégration Google Docs (facultative) -----------------------------------
# Si l'une des quatre variables ci-dessous manque, l'intégration est désactivée.
# Pas à pas : README, section « Intégration Google Docs ».

# Adresse publique de l'application, sans / final. Sert à construire l'URI de
# redirection OAuth : <APP_URL>/api/integrations/google/callback
APP_URL=http://localhost:3000

# Identifiants OAuth (Google Cloud Console > Google Auth Platform > Clients).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clé de chiffrement des jetons OAuth stockés en base : 32 octets encodés en base64.
# Pour la générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si vous la changez, chaque utilisateur devra reconnecter son compte Google.
INTEGRATIONS_ENCRYPTION_KEY=
