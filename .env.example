# URL de connexion Neon (Dashboard Neon > Connect > "Pooled connection").
# Laisser vide pour utiliser la base locale de démo (dossier .pglite/).
DATABASE_URL=

# Fuseau horaire de l'équipe (sert à calculer "aujourd'hui", "en retard", "cette semaine").
APP_TIMEZONE=Europe/Paris

# --- Emails (vérification d'adresse, mot de passe oublié, invitations) --------
# Obligatoires en production : sans elles, l'inscription affiche que l'email n'a pas pu partir.
# En local, sans RESEND_API_KEY, les emails sont écrits dans la console du serveur.
# Clé d'API Resend (resend.com > API Keys, permission "Sending access").
RESEND_API_KEY=
# Domaine vérifié dans Resend (Domains) : les emails partent de noreply@<ce domaine>.
EMAIL_FROM_DOMAIN=
# Les liens des emails utilisent aussi APP_URL (plus bas) : en production, l'adresse publique.

# --- Intégration Google Docs (facultative) -----------------------------------
# Si l'une des quatre variables ci-dessous manque, l'intégration est désactivée.
# Pas à pas : README, section « Intégration Google Docs ».

# Adresse publique de l'application, sans / final. Sert à construire l'URI de
# redirection OAuth : <APP_URL>/api/integrations/google/callback, et les liens des emails
# (obligatoire en production pour envoyer des emails).
APP_URL=http://localhost:3000

# Identifiants OAuth (Google Cloud Console > Google Auth Platform > Clients).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clé de chiffrement des jetons OAuth stockés en base : 32 octets encodés en base64.
# Pour la générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si vous la changez, chaque utilisateur devra reconnecter son compte Google.
INTEGRATIONS_ENCRYPTION_KEY=

# --- Intégration Discord (facultative) ---------------------------------------
# Jeton du bot Discord (Developer Portal > votre application > Bot > Reset Token).
# Reste côté serveur : le navigateur n'appelle jamais Discord directement.
# Nécessite aussi INTEGRATIONS_ENCRYPTION_KEY (le jeton du webhook est chiffré en base).
# Si l'une des deux manque, l'intégration est désactivée. Pas à pas : docs/discord.md
DISCORD_BOT_TOKEN=
